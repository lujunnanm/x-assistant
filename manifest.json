{
  "manifest_version": 3,
  "name": "神圣计划",
  "version": "4.0.14",
  "description": "X 自动化运营控制台：发帖、互动、回帖协同调度，DeepSeek 同语种生成，发送回执核验与独立清理。",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开神圣计划",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "panel.html",
  "host_permissions": [
    "https://x.com/*",
    "https://api.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "interaction-core.js",
        "runtime-client.js",
        "coordination.js",
        "posting-receipt.js",
        "cleanup-core.js",
        "scheduler-core.js",
        "popup-guard.js",
        "task-utils.js",
        "x-dom.js",
        "reply-engine.js",
        "notification-policy.js",
        "overlay.js",
        "notifications.js",
        "posting.js",
        "cleanup.js",
        "module-entry.js",
        "scheduler.js",
        "compact-controls.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "神圣计划",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-48.png",
        "post-images/*.jpg"
      ],
      "matches": [
        "https://x.com/*"
      ]
    }
  ]
}
