{
  "manifest_version": 3,
  "name": "X 文案助手",
  "version": "2.0.21",
  "description": "X 页面悬浮互动循环：可按关注状态或高曝光条件自动评价、点赞和关注。",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 X 文案助手"
  },
  "options_page": "panel.html",
  "host_permissions": [
    "https://x.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "interaction-core.js",
        "runtime-client.js",
        "coordination.js",
        "posting-receipt.js",
        "cleanup-core.js",
        "reply-cleanup.js",
        "overlay.js",
        "posting.js",
        "cleanup.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
