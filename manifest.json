{
  "manifest_version": 3,
  "name": "神圣计划",
  "version": "8.0.12",
  "description": "神圣计划：独立管理发帖、互动、回帖与认证关注者回关。",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开神圣计划",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "panel.html",
  "host_permissions": [
    "https://x.com/*",
    "https://api.deepseek.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "time-policy.js",
        "time-client.js",
        "interaction-preferences.js",
        "interaction-core.js",
        "interaction-fallback-library.js",
        "runtime-client.js",
        "posting-receipt.js",
        "popup-guard.js",
        "task-utils.js",
        "action-client.js",
        "x-dom.js",
        "deletion-dom.js",
        "reply-engine.js",
        "notification-policy.js",
        "service-policy.js",
        "workspace-policy.js",
        "view.js",
        "home-timeline.js",
        "timeline-copy.js",
        "overlay.js",
        "notifications.js",
        "profile-replies.js",
        "posting.js",
        "notifications-driver.js",
        "module-entry.js",
        "followback.js",
        "workspace.js",
        "timeline-search.js",
        "console.js"
      ],
      "css": [
        "timeline-copy.css",
        "timeline-search.css",
        "overlay.css",
        "fault-indicator.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "thread-ownership.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "short_name": "神圣计划",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-48.png",
        "post-images/*.jpg",
        "icons/stone-grain.png",
        "post-images/*.jpeg",
        "post-images/*.png",
        "post-images/*.webp"
      ],
      "matches": [
        "https://x.com/*"
      ]
    }
  ]
}
